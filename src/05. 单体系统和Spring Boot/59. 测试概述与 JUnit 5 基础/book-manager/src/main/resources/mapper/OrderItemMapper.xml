<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookmanager.mapper.OrderItemMapper">
    <resultMap id="OrderItemMap" type="OrderItem">
        <id property="id" column="id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
        <result property="orderId" column="order_id"/>
        <result property="bookId" column="book_id"/>
    </resultMap>

    <resultMap id="OrderItemWithBookMap" type="OrderItem" extends="OrderItemMap">
        <association property="book" javaType="Book"
                     resultMap="com.example.bookmanager.mapper.BookMapper.BookResultMap"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="OrderItemWithBookMap">
        SELECT oi.*, b.*
        FROM order_item oi
                 LEFT JOIN book b ON oi.book_id = b.id
        WHERE oi.order_id = #{orderId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_item (quantity, price, order_id, book_id)
        VALUES (#{quantity}, #{price}, #{orderId}, #{bookId})
    </insert>

    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_item (quantity, price, order_id, book_id)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.quantity}, #{item.price}, #{item.orderId}, #{item.bookId})
        </foreach>
    </insert>

    <delete id="deleteByOrderId">DELETE FROM order_item WHERE order_id = #{orderId}</delete>
</mapper>