# 环境变量的示例文件

# 两个可选值：
# 1. fake 使用模拟模型
# 2. ark 使用真实模型
TEXT_MODEL_PROVIDER=

# 火山引擎里面申请的 api key
ARK_API_KEY=

# 文本模式
ARK_MODEL=

# 模拟生成角色设定和场景设定的时候，是否出错
# 支持配置的值有：none、characters、scenes
# 1. none 正查生成，角色和场景两边都ok
# 2. characters：生成角色出错了
# 3. scenes：生成场景出错了
FAKE_PLANNING_FAULT=none

# 模拟生成分镜的时候报错
# 模拟的是硬规则的各种情况
# 支持配置的值有：none、duplicate_id、unknown_character、duration_mismatch
# none：没有错误，生成的分镜都是正常的
# duplicate_id：生成的分镜的id重复了
# unknown_character：引用了未知的角色
# duration_mismatch：时长不匹配
FAKE_STORYBOARD_FAULT=duplicate_id

# 模拟大模型评审分镜时生成的报告的类型
# 支持配置的值有：
# none、plot_gap、character_inconsistent、visual_unclear、motion_conflict、invalid_report
FAKE_QUALITY_FAULT=none

# 模拟分镜修订走向。
# 支持配置的值有：none、second_pass、always_fail、unchanged、hard_regression、repeat_version
# none：按质量报告改目标镜头，产生新版本。
# second_pass：首评失败，修订后复评通过。
# always_fail：每次评价都不通过，改满次数后 revision_exhausted。
# unchanged：修订内容不变，停在 revision_stalled / no_change。
# hard_regression：修订后引用不存在的角色，再撞硬规则。
# repeat_version：第二次修订退回初版，停在 revision_stalled / repeated_version。
FAKE_REVISION_SCENARIO=none